{
  "mcpServers": {
    "figma-desktop": {
      "url": "http://127.0.0.1:3845/mcp",
      "type": "http",
      "disabled": false,
      "autoApprove": [
        "get_design_context",
        "get_metadata",
        "get_screenshot",
        "get_variable_defs",
        "get_code_connect_map",
